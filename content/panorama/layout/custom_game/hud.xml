<root>
    <scripts>
        <include src="file://{resources}/scripts/custom_game/hud.js" />
    </scripts>

    <styles>
        <include src="s2r://panorama/styles/dotastyles.css" />
        <include src="file://{resources}/styles/custom_game/hud.css" />
    </styles>

    <Panel hittest="false" class="MainHud">

        <!-- In the row of Dota's top-left buttons: reorder (also F8) and, in tools only, the dev panel. -->
        <Panel id="TopLeftButtons" hittest="false">
            <TextButton id="ReorderHint" class="TopButton" text="F8" />
            <Panel id="DevPanel" hittest="false">
                <TextButton id="DevPanelToggle" class="TopButton Dev" text="DEV" />
                <Panel id="DevButtons" />
            </Panel>
        </Panel>

        <!-- Over Dota's Aghanim's indicator: our tooltip lists the drafted abilities it upgrades. -->
        <Panel id="AghsOverlay" hittest="false" />
        <Panel id="AghsTooltip" hittest="false" />
        <!-- The tooltip's pointer, drawn after it so it covers the bottom border. -->
        <Panel id="AghsTooltipArrow" hittest="false" />

        <!-- Reorder mode: drag abilities onto each other in a preview; nothing changes until "Apply". -->
        <Panel id="ReorderPanel" hittest="true">
            <Label id="ReorderTitle" text="#hud_reorder_title" />
            <Label id="ReorderHelp" text="#hud_reorder_help" />
            <Panel id="ReorderSlots" />
            <Panel id="ReorderButtons">
                <TextButton id="ReorderReset" class="ReorderButton" text="#hud_reorder_reset" />
                <TextButton id="ReorderCancel" class="ReorderButton" text="#hud_reorder_cancel" />
                <TextButton id="ReorderApply" class="ReorderButton Primary" text="#hud_reorder_apply" />
            </Panel>
        </Panel>
    </Panel>
</root>
