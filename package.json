{
    "name": "turbo_ability_draft",
    "version": "0.1.0",
    "private": true,
    "license": "UNLICENSED",
    "author": {
        "name": "Hernan Case",
        "url": "https://hercase.vercel.app"
    },
    "engines": {
        "node": ">=22.12"
    },
    "scripts": {
        "postinstall": "node scripts/install.js",
        "launch": "node scripts/launch.js",
        "build": "run-p build:*",
        "build:panorama": "tsc --project src/panorama/tsconfig.json",
        "build:vscripts": "tstl --project src/vscripts/tsconfig.json",
        "dev": "run-p dev:*",
        "dev:panorama": "tsc --project src/panorama/tsconfig.json --watch",
        "dev:vscripts": "tstl --project src/vscripts/tsconfig.json --watch",
        "abilities:diff": "node scripts/ability-diff.js",
        "lint": "eslint .",
        "lint:fix": "eslint . --fix",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "prepare": "lefthook install",
        "typecheck": "tsc --noEmit -p src/vscripts/tsconfig.json && tsc --noEmit -p src/panorama/tsconfig.json"
    },
    "devDependencies": {
        "@commitlint/cli": "^21.2.3",
        "@commitlint/config-conventional": "^21.2.3",
        "@eslint/js": "^10.0.1",
        "@moddota/dota-lua-types": "^4.34.1",
        "@moddota/find-steam-app": "^1.1.0",
        "@moddota/panorama-types": "^1.30.0",
        "eslint": "^10.12.0",
        "eslint-config-prettier": "^10.1.8",
        "fs-extra": "^9.0.0",
        "globals": "^17.13.0",
        "lefthook": "^2.2.2",
        "npm-run-all": "^4.1.5",
        "prettier": "^3.9.10",
        "prettier-plugin-organize-imports": "^4.3.0",
        "typescript": "5.5.2",
        "typescript-eslint": "^8.71.2",
        "typescript-to-lua": "^1.26.0"
    }
}
